{
  "name": "ve-con-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build --workspaces",
    "prisma:generate": "npx prisma generate --schema=backend/prisma/schema.prisma"
  },
  "devDependencies": {
    "concurrently": "^9.2.5"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true,
    "esbuild@0.28.2": true
  },
  "dependencies": {
    "@eslint-community/eslint-utils": "^4.10.1",
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "@typescript-eslint/scope-manager": "^8.71.2",
    "@typescript-eslint/tsconfig-utils": "^8.71.2",
    "@typescript-eslint/type-utils": "^8.71.2",
    "@typescript-eslint/types": "^8.71.2",
    "@typescript-eslint/typescript-estree": "^8.71.2",
    "@typescript-eslint/utils": "^8.71.2",
    "@typescript-eslint/visitor-keys": "^8.71.2",
    "debug": "^4.4.3",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "semver": "^7.8.5",
    "ts-api-utils": "^2.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
