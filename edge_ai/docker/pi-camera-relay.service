# Pi Camera の MJPEG 配信を自動起動する（ラズパイのホスト側）
#   ExecStart のパスとユーザー名を自分の環境に合わせてから:
#   sudo cp edge_ai/docker/pi-camera-relay.service /etc/systemd/system/
#   sudo systemctl enable --now pi-camera-relay
[Unit]
Description=Pi Camera MJPEG relay for AGV
After=network.target

[Service]
User=pi
ExecStart=/usr/bin/python3 /home/pi/VE-con/edge_ai/docker/pi_camera_relay.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
