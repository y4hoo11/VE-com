// schema.prisma
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  OPERATOR
  VIEWER
}

// 車両のステータス定義
enum VehicleStatus {
  IDLE
  RUNNING
  CHARGING
  ERROR
  OFFLINE
}

enum TaskStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  FAILED
}

// ログレベル定義
enum LogLevel {
  INFO
  WARN
  ERROR
}

enum SettingCategory {
  GENERAL
  AGV
  SYSTEM
}

model User {
  id           String           @id @default(uuid())
  username     String           @unique
  email        String           @unique
  passwordHash String           @map("password_hash")
  role         Role             @default(OPERATOR)
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  createdTasks   Task[]           @relation("UserCreatedTasks")
  systemSettings SystemSetting[]  @relation("UserUpdatedSettings")
  changeRequests SettingChangeRequest[] @relation("UserChangeRequests")
  changeReviews  SettingChangeReview[]

  @@map("users")
}

// 車両 (AGV) モデル
model Vehicle {
  id            String        @id // 例: AGV-01
  name          String
  status        VehicleStatus @default(IDLE)
  batteryLevel  Int           @default(100) @map("battery_level")
  currentX      Float         @default(0.0) @map("current_x")
  currentY      Float         @default(0.0) @map("current_y")
  currentTheta  Float?        @map("current_theta")
  currentMapId  String?       @map("current_map_id")
  lastHeartbeat DateTime?     @map("last_heartbeat")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  tasks Task[]
  logs  VehicleLog[]

  @@map("vehicles")
}

// タスクモデル
model Task {
  id                String     @id @default(uuid())
  title             String
  status            TaskStatus @default(PENDING)
  priority          Int        @default(3) // 1: Low ~ 5: High
  assignedVehicleId String?    @map("assigned_vehicle_id")
  startLocation     String?    @map("start_location")
  targetLocation    String?    @map("target_location")
  createdByUserId   String?    @map("created_by_user_id")
  scheduledAt       DateTime?  @map("scheduled_at")
  startedAt         DateTime?  @map("started_at")
  completedAt       DateTime?  @map("completed_at")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  assignedVehicle Vehicle?      @relation(fields: [assignedVehicleId], references: [id], onDelete: SetNull)
  createdByUser   User?         @relation("UserCreatedTasks", fields: [createdByUserId], references: [id], onDelete: SetNull)
  histories       TaskHistory[]

  @@map("tasks")
}

model VehicleLog {
  id        BigInt   @id @default(autoincrement())
  vehicleId String   @map("vehicle_id")
  logLevel  LogLevel @map("log_level")
  message   String
  details   Json?
  timestamp DateTime @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@map("vehicle_logs")
}

model TaskHistory {
  id        BigInt     @id @default(autoincrement())
  taskId    String     @map("task_id")
  status    TaskStatus
  note      String?
  timestamp DateTime   @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("task_histories")
}

model SystemSetting {
  key             String          @id // 例: mqtt.broker_url
  value           String
  category        SettingCategory @default(GENERAL)
  description     String?
  updatedByUserId String?         @map("updated_by_user_id")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  updatedByUser User? @relation("UserUpdatedSettings", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@map("system_settings")
}

// 設定変更の申請の状態
enum ChangeRequestStatus {
  PENDING // 承認待ち
  APPROVED // 必要な承認がそろい、変更待ち
  REJECTED // 不承認
  WITHDRAWN // 申請者が取り下げた
  APPLIED // 変更済み
}

enum ReviewDecision {
  APPROVE
  REJECT
}

// 設定変更の申請と、その変更の記録（管理者が申請なしで変更したときも direct = true で残す）
model SettingChangeRequest {
  id                String              @id @default(uuid())
  settingKey        String              @map("setting_key") // 例: battWarn
  settingLabel      String              @map("setting_label")
  rank              Int // 1〜3（L1〜L3）
  currentValue      String              @map("current_value") // 申請したときの値
  requestedValue    String              @map("requested_value")
  reason            String
  effect            String?
  safetyRule        String?             @map("safety_rule")
  pledgedAt         DateTime?           @map("pledged_at") // L3 の誓約をした日時
  status            ChangeRequestStatus @default(PENDING)
  direct            Boolean             @default(false)
  requestedByUserId String?             @map("requested_by_user_id")
  requestedByName   String              @map("requested_by_name") // ユーザーが消えても記録に残すため
  appliedValue      String?             @map("applied_value")
  appliedByName     String?             @map("applied_by_name")
  signature         String? // 変更したときの簡易サイン
  appliedAt         DateTime?           @map("applied_at")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  requestedBy User?                 @relation("UserChangeRequests", fields: [requestedByUserId], references: [id], onDelete: SetNull)
  reviews     SettingChangeReview[]

  @@index([status])
  @@map("setting_change_requests")
}

// 申請への承認・不承認
model SettingChangeReview {
  id           BigInt         @id @default(autoincrement())
  requestId    String         @map("request_id")
  userId       String?        @map("user_id")
  reviewerName String         @map("reviewer_name")
  decision     ReviewDecision
  comment      String?
  createdAt    DateTime       @default(now()) @map("created_at")

  request SettingChangeRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  user    User?                @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([requestId, userId])
  @@map("setting_change_reviews")
}
