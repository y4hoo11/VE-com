# ==========================================
# 共通 (OS / IDE / エディタ / ログ)
# ==========================================
.DS_Store
Thumbs.db
*.log
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
.idea/

# 開発用環境変数 (機密情報が含まれるため除外)
.env
.env.local
.env.*.local

# ==========================================
# モノレポ共通 (ルート & 全パッケージ共通)
# ==========================================
# ★ ルート直下およびサブフォルダすべての node_modules を一括除外
node_modules/
.pnpm-store/
.tsbuildinfo

# ビルド成果物・出力ディレクトリ（全層共通）
dist/
build/
out/
.next/

# ==========================================
# 1. Edge AI / ROS 2 (edge_ai/)
# ==========================================
# colcon build による自動生成物
edge_ai/ros2_ws/build/
edge_ai/ros2_ws/install/
edge_ai/ros2_ws/log/

# Pythonのキャッシュ
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# ==========================================
# 2. Hardware / Firmware (firmware/)
# ==========================================
# PlatformIO ビルド生成物
firmware/.pio/
firmware/.clang_complete
firmware/.gcc-flags.json